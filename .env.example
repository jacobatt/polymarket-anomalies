# Copy this file to .env and fill in real values. Never commit .env.

# From Supabase: Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Polymarket Data API. The default is the public production endpoint;
# only set this if you need to point at a mirror or proxy.
# POLYMARKET_API_URL=https://data-api.polymarket.com/trades

# Discord alerts moved out of this cron and into the Vercel worker at
# /api/alerts/run in the polyanomalies repo. Configure rules via the
# /alerts UI; set DISCORD_WEBHOOK_URL in Vercel env (not here) for the
# fallback channel.
